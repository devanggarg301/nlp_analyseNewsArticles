# Copy this file to .env in the project root; restart the backend.
# No API credentials are required for trained detection, NER, NLI or extractive search.
# These settings enable generated RAG answers and structured entity sentiment.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
# Set the endpoint/model for any provider offering compatible chat completions
# with JSON-object response format. Do not put the key in the frontend.

